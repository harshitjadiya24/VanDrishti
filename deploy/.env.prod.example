# Copy to deploy/.env.prod (git-ignored), fill in, chmod 600.
# Generate secrets: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
VANDRISHTI_DOMAIN=vandrishti.example.org
VANDRISHTI_DB_PASSWORD=
VANDRISHTI_INGEST_TOKEN=
VANDRISHTI_ALERT_WEBHOOK_URL=
VANDRISHTI_ALERT_WEBHOOK_SECRET=
VANDRISHTI_VERSION=0.2.0
# Image store on the host (chown -R 10001:10001 it before the first start).
VANDRISHTI_STORE_DIR=/srv/vandrishti/store
