# Copy to .env and adjust. Never commit .env.
VANDRISHTI_ENV=dev
VANDRISHTI_LOG_LEVEL=INFO
VANDRISHTI_LOG_JSON=true

# Postgres (matches docker-compose.yml defaults)
VANDRISHTI_DB_HOST=localhost
VANDRISHTI_DB_PORT=5432
VANDRISHTI_DB_USER=vandrishti
VANDRISHTI_DB_PASSWORD=change-me
VANDRISHTI_DB_NAME=vandrishti
VANDRISHTI_REDIS_URL=redis://localhost:6379/0

# Storage: originals are immutable and content-addressed. Relative paths = repo root.
VANDRISHTI_STORAGE_ROOT=data/store
VANDRISHTI_MODEL_CACHE_DIR=data/models

# Models (8 GB M3: one heavy model at a time)
VANDRISHTI_MODEL_DEVICE=auto
VANDRISHTI_MODEL_MAX_LOADED=1
VANDRISHTI_MODEL_MEMORY_BUDGET_MB=3000

# Ingestion and preprocessing (Phase 1)
VANDRISHTI_SEQUENCE_GAP_SECONDS=10
VANDRISHTI_DISPLAY_MAX_SIDE=1600
VANDRISHTI_DENOISE=false
VANDRISHTI_UPLOAD_MAX_MB=50
VANDRISHTI_WATCH_INTERVAL_SECONDS=30
# Bearer token for write endpoints until login (Phase 8). Unset: writes only with ENV=dev.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# VANDRISHTI_INGEST_TOKEN=

# Detection (Phase 2). CPU measured faster than MPS for the compact detector on an M3.
VANDRISHTI_DETECTOR_DEVICE=cpu
VANDRISHTI_DETECTOR_BATCH_SIZE=8
VANDRISHTI_DETECTOR_MIN_CONFIDENCE=0.05
VANDRISHTI_ANIMAL_THRESHOLD=0.2
VANDRISHTI_PRIVACY_THRESHOLD=0.1

# Species, semantic check, segmentation (Phase 3)
VANDRISHTI_SPECIESNET_TOOL_DIR=tools/speciesnet
VANDRISHTI_SEGMENTER_DEVICE=cpu
VANDRISHTI_VERIFIER_DEVICE=cpu

# Tiger re-identification (Phase 6). MegaDescriptor is CC-BY-NC-4.0 (non-commercial).
# The 0.76 line belongs to MegaDescriptor; dinov2-small would need its own (0.884 on ATRW).
VANDRISHTI_REID_MODEL=megadescriptor-t-224
VANDRISHTI_REID_MATCH_THRESHOLD=0.76
VANDRISHTI_REID_DEVICE=cpu

